# Database (docker-compose default)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/x25x125
# Free Socrata app token (data.cityofchicago.org and datacatalog.cookcountyil.gov) - optional to start
SOCRATA_APP_TOKEN=
# Free Census API key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
# Later: RentCast API (paid rent estimates)
RENTCAST_API_KEY=
# Later, only after MRED approves the feed: MLS Grid token
MLSGRID_TOKEN=
# AI tooling for the build (see CLAUDE.md). Never commit real keys.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ---- Accounts, billing and operations (TASKS.md step 6 and SaaS setup) ----
# Everything below works empty on your own computer (dev mode). Set APP_ENV=production on the hosts; production
# refuses the dev fallbacks. The web app reads its own copy: put the web lines in web/.env.local too.
APP_ENV=development
# Shared by the engine and the web app; signs the user and organization on every engine call.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENGINE_SHARED_SECRET=
# Web app only: its public address, used in sign-in emails and Stripe return pages (e.g. https://app.25x125.com).
APP_URL=
# Engine only: SMTP for sign-in and invite emails, e.g. smtp://resend:<api key>@smtp.resend.com:587
# (smtps://...:465 for TLS). Empty = dev mode: links print in the engine console and go to .dev-mail/.
EMAIL_SERVER=
EMAIL_FROM=25x125 <sign-in@example.com>
# Engine only: Stripe, test mode keys (sk_test_..., whsec_...) until launch. Price ids from the Stripe dashboard:
# Pro $129 a month and the founding price $79 a month (data/rules/plans.json).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_FOUNDING_MONTHLY=
# Engine and web app: error tracking (Sentry DSN). Empty = errors are only logged.
SENTRY_DSN=

# Production secrets for python -m scripts.deploy (docs/deploy.md).
# Copy to .env.production (git ignores it), fill in, then run the deploy script. Never commit the filled copy.
# The script sends each value to Fly as a secret through stdin; it never prints them.

# Fly organization for the three apps (from `fly orgs list`; "personal" for a personal account).
FLY_ORG=personal

# ---- Database: Supabase Pro, region us-east-1 ----
# Dashboard > your project > Connect > "Direct connection" (port 5432). Add ?sslmode=require.
#   postgresql://postgres:<db password>@db.<project ref>.supabase.co:5432/postgres?sslmode=require
# The direct host is IPv6 only. Fly has IPv6, so the engine, tile server and nightly job use it.
# If the deploy log shows "Network is unreachable", use the "Session pooler" string instead (also port 5432,
# IPv4 and IPv6; user is postgres.<project ref>):
#   postgresql://postgres.<project ref>:<db password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Never the transaction pooler (port 6543): it breaks the per-request role switch and Martin's statements.
DATABASE_URL=postgresql://postgres:replace-with-db-password@db.replace-with-project-ref.supabase.co:5432/postgres?sslmode=require

# ---- Engine and web app ----
# Signs every web-to-engine call. Make one (run it once and paste the output):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENGINE_SHARED_SECRET=replace-with-output-of-the-command-above
# The site's public address: Fly's https://x25x125-web.fly.dev until a domain is attached.
APP_URL=https://x25x125-web.fly.dev

# ---- Email: Resend (free tier, 3,000 emails a month, 100 a day) ----
# resend.com > API Keys > Create (permission "Sending access"). Verify the sending domain first (Domains).
# Port 465 = TLS from the start (smtps); 587 with smtp:// also works.
EMAIL_SERVER=smtps://resend:re_replace-with-api-key@smtp.resend.com:465
EMAIL_FROM=25x125 <sign-in@replace-with-your-domain.com>

# ---- Billing: Stripe (test mode keys until launch: sk_test_..., whsec_...) ----
# Dashboard > Developers > API keys (secret key). Webhook: Developers > Webhooks > Add endpoint
#   <APP_URL>/api/billing/webhook, events checkout.session.completed and customer.subscription.*;
#   copy its signing secret. Price ids from Product catalog: Pro $129/month, founding $79/month.
# Empty = billing buttons are off; the 14-day trial still works.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_FOUNDING_MONTHLY=

# ---- Errors: Sentry (free Developer plan) ----
# sentry.io > Create project (platform: Python is fine for both) > Client Keys (DSN). Empty = logs only.
SENTRY_DSN=

# ---- Data sources (free) ----
# Socrata app token: data.cityofchicago.org > Sign in > Developer settings > Create new app token.
SOCRATA_APP_TOKEN=
# Census API key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
